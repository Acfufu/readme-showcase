{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Acfufu/readme-showcase/schemas/readme-plan.v1.schema.json",
  "title": "README Plan v1",
  "$comment": "Python semantic validation rejects float runtime values because JSON Schema treats 1.0 as an integer.",
  "x-python-semantic-validation": {
    "code": "E_SCHEMA_FLOAT",
    "rule": "runtime values must use Python int, never float",
    "validator": "skill.scripts.readme_showcase.contracts.plan.validate_readme_plan"
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "languages", "sections", "visual_intent", "diagram_route", "commands", "evidence_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"enum": ["readme", "asset-only", "audit-only"]},
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["en", "zh"]}
    },
    "sections": {"$ref": "#/$defs/textArray"},
    "visual_intent": {"$ref": "#/$defs/text"},
    "diagram_route": {"enum": ["none", "static", "elk"]},
    "commands": {"$ref": "#/$defs/textArray"},
    "evidence_ids": {"$ref": "#/$defs/textArray"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!.*(?:^|\\s)(?:/|~/))(?!.*(?i:api[_-]?key|api[_-]?token|access[_-]?token|auth[_-]?token|password|private[_-]?key|secret)\\s*[:=])[^\\u0000]+$"},
    "textArray": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/text"}
    }
  }
}
