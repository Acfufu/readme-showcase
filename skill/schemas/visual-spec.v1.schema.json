{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Acfufu/readme-showcase/schemas/visual-spec.v1.schema.json",
  "title": "Visual Spec v1",
  "$comment": "Draft 2020-12 validates the closed shape; Python validation additionally enforces NFC text, byte-sorted IDs, graph references, Evidence v2 membership, resource/path safety, and the canonical size bound.",
  "x-python-semantic-validation": {
    "codes": [
      "E_SCHEMA_FLOAT",
      "E_SCHEMA_VALUE",
      "E_VISUAL_SPEC_SIZE",
      "E_VISUAL_SPEC_ID",
      "E_VISUAL_SPEC_EDGE",
      "E_VISUAL_SPEC_EVIDENCE",
      "E_VISUAL_RESOURCE",
      "E_VISUAL_PATH"
    ],
    "validator": "skill.scripts.readme_showcase.visual_kernel.model.validate_visual_spec"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent",
    "locale",
    "variants",
    "nodes",
    "edges",
    "groups",
    "lanes",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "desktop",
          "mobile"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "lanes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    }
  },
  "$defs": {
    "locale": {
      "enum": [
        "en",
        "zh-Hans",
        "zh-Hant",
        "ja",
        "ko",
        "fr",
        "de"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s)(?:[^\\u0000]*\\S)$"
    },
    "id": {
      "$ref": "#/$defs/text"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[a-z]+:[0-9a-f]{64}$"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidenceId"
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "label",
        "evidence_ids"
      ],
      "properties": {
        "kind": {
          "enum": [
            "architecture",
            "flow",
            "swimlane",
            "sequence"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "actor",
            "service",
            "process",
            "store",
            "decision",
            "note"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        },
        "group_id": {
          "$ref": "#/$defs/id"
        },
        "lane_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "flow",
            "dependency",
            "data",
            "back"
          ]
        },
        "source": {
          "$ref": "#/$defs/id"
        },
        "target": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      },
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "label"
                ]
              },
              {
                "required": [
                  "evidence_ids"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "label",
            "evidence_ids"
          ]
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "evidence_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "rank": {
          "type": "integer",
          "minimum": 0
        },
        "pin": {
          "type": "integer",
          "minimum": 0
        }
      },
      "anyOf": [
        {
          "required": [
            "order"
          ]
        },
        {
          "required": [
            "rank"
          ]
        },
        {
          "required": [
            "pin"
          ]
        }
      ]
    }
  }
}
