{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Acfufu/readme-showcase/schemas/run-manifest.v1.schema.json",
  "title": "README Showcase Run Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "created_at", "updated_at", "status", "target", "configuration", "current_stage", "stages"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "status": {
      "enum": ["created", "running", "waiting-for-plan", "waiting-for-candidate", "failed", "manual-review-required", "complete"]
    },
    "target": {"$ref": "#/$defs/target"},
    "configuration": {"$ref": "#/$defs/configuration"},
    "current_stage": {
      "type": ["string", "null"],
      "enum": [null, "scan", "retrieve", "plan-import", "generation-request", "candidate", "bundle-assemble", "validation", "evaluation"]
    },
    "stages": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"$ref": "#/$defs/stage-scan"},
        {"$ref": "#/$defs/stage-retrieve"},
        {"$ref": "#/$defs/stage-plan-import"},
        {"$ref": "#/$defs/stage-generation-request"},
        {"$ref": "#/$defs/stage-candidate"},
        {"$ref": "#/$defs/stage-bundle-assemble"},
        {"$ref": "#/$defs/stage-validation"},
        {"$ref": "#/$defs/stage-evaluation"}
      ],
      "items": false
    }
  },
  "$defs": {
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nullable-sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "repository", "base_sha"],
      "properties": {
        "root": {"type": "string", "pattern": "^/"},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "project_type", "locales", "scanner_profile"],
      "properties": {
        "mode": {"type": "string", "minLength": 1},
        "project_type": {"type": "string", "minLength": 1},
        "locales": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "scanner_profile": {"type": "string", "minLength": 1}
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "input_sha256", "output_sha256", "attempt", "started_at", "completed_at"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["pending", "running", "pass", "failed", "stale", "waiting-for-plan", "waiting-for-candidate"]},
        "input_sha256": {"$ref": "#/$defs/nullable-sha256"},
        "output_sha256": {"$ref": "#/$defs/nullable-sha256"},
        "attempt": {"type": "integer", "minimum": 0},
        "started_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "completed_at": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "stage-scan": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "scan"}}},
    "stage-retrieve": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "retrieve"}}},
    "stage-plan-import": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "plan-import"}}},
    "stage-generation-request": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "generation-request"}}},
    "stage-candidate": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "candidate"}}},
    "stage-bundle-assemble": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "bundle-assemble"}}},
    "stage-validation": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "validation"}}},
    "stage-evaluation": {"$ref": "#/$defs/stage", "properties": {"name": {"const": "evaluation"}}}
  }
}
