{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Acfufu/readme-showcase/schemas/asset-manifest.v2.schema.json",
  "title": "Asset Manifest v2",
  "$comment": "Python semantic validation binds provenance to Evidence v2 and exact regular-file bytes.",
  "x-python-semantic-validation": {"validator": "skill.scripts.readme_showcase.contracts.assets.validate_asset_manifest", "codes": ["E_PATH", "E_BUNDLE_HASH", "E_ASSET_LOCALE"]},
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"const": 2},
    "assets": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000]+$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/|~/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\\\\\u0000]+$"},
    "evidenceId": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[a-z]+:[0-9a-f]{64}$"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {"kind": {"enum": ["hand-authored", "derived", "generated"]}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "path", "language_neutral", "provenance", "artifact_sha256", "candidate_sha256", "evidence_ids"],
      "oneOf": [
        {"required": ["locale"], "properties": {"language_neutral": {"const": false}}},
        {"not": {"required": ["locale"]}, "properties": {"language_neutral": {"const": true}}}
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/path"}, "locale": {"enum": ["en", "zh-Hans", "zh-Hant", "ja", "ko", "fr", "de"]}, "language_neutral": {"type": "boolean"},
        "provenance": {"$ref": "#/$defs/provenance"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/evidenceId"}}
      }
    }
  }
}
