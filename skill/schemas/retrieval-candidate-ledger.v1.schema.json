{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readme-showcase.local/schemas/retrieval-candidate-ledger.v1.schema.json",
  "title": "Retrieval candidate ledger v1",
  "$comment": "Python validation additionally enforces canonical bytes, sorted identifiers, source identity/hash bindings, production overlap exclusion, canonical commit-pinned URLs, receipt hashes, and safe regular-file loading.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "source_manifest_sha256", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"const": "readme-showcase-retrieval-candidates"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidates": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "spdx": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"},
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$"
    },
    "slugs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/slug"}
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "url"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "url": {"type": "string", "pattern": "^https://github\\.com/.+/blob/[0-9a-f]{40}/.+$"}
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "spdx", "evidence_url", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "spdx": {"$ref": "#/$defs/spdx"},
        "evidence_url": {"type": "string", "pattern": "^https://github\\.com/.+/blob/[0-9a-f]{40}/.+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_url", "commit", "material_sha256", "license_sha256"],
      "properties": {
        "repository_url": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "material_sha256": {"$ref": "#/$defs/sha256"},
        "license_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_size", "user_role", "install_method", "has_ui", "multi_package", "primary_readme_goal"],
      "properties": {
        "project_size": {"enum": ["small", "medium", "large"]},
        "user_role": {"type": "string", "minLength": 1, "maxLength": 240},
        "install_method": {"type": "string", "minLength": 1, "maxLength": 240},
        "has_ui": {"type": "boolean"},
        "multi_package": {"type": "boolean"},
        "primary_readme_goal": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "approval_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "reviewer_identity", "reviewer_kind", "reviewed_at", "decision", "source_commit", "review_packet_sha256", "material_sha256", "license_sha256", "receipt_sha256"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/slug"},
        "reviewer_identity": {"type": "string", "pattern": "^human:.+$", "maxLength": 240},
        "reviewer_kind": {"const": "external-human"},
        "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "decision": {"enum": ["approved", "rejected"]},
        "source_commit": {"$ref": "#/$defs/commit"},
        "review_packet_sha256": {"$ref": "#/$defs/sha256"},
        "material_sha256": {"$ref": "#/$defs/sha256"},
        "license_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id", "repository_url", "commit", "material", "license", "source_identity", "intended_split", "project_type", "section_intents", "tags", "metadata", "review_status", "approval_receipt"],
      "properties": {
        "record_id": {"$ref": "#/$defs/slug"},
        "repository_url": {"$ref": "#/$defs/repository"},
        "commit": {"$ref": "#/$defs/commit"},
        "material": {"$ref": "#/$defs/material"},
        "license": {"$ref": "#/$defs/license"},
        "source_identity": {"$ref": "#/$defs/source_identity"},
        "intended_split": {"const": "train"},
        "project_type": {"enum": ["developer-tool", "library", "runtime-toolchain", "web-framework"]},
        "section_intents": {"$ref": "#/$defs/slugs"},
        "tags": {"$ref": "#/$defs/slugs"},
        "metadata": {"$ref": "#/$defs/metadata"},
        "review_status": {"enum": ["unverified", "approved", "rejected"]},
        "approval_receipt": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/approval_receipt"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"review_status": {"const": "unverified"}}, "required": ["review_status"]},
          "then": {"properties": {"approval_receipt": {"type": "null"}}}
        },
        {
          "if": {"properties": {"review_status": {"enum": ["approved", "rejected"]}}, "required": ["review_status"]},
          "then": {"properties": {"approval_receipt": {"$ref": "#/$defs/approval_receipt"}}}
        }
      ]
    }
  }
}
