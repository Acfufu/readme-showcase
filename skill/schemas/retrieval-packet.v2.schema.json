{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readme-showcase.local/schemas/retrieval-packet.v2.schema.json",
  "title": "Retrieval packet v2",
  "$comment": "Python validation additionally rejects floats, duplicate identities, dangling reasons, and production test-split leakage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "mode", "query", "dataset", "records", "reason"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["available", "unavailable"]},
    "mode": {"enum": ["production", "benchmark"]},
    "query": {"$ref": "#/$defs/query"},
    "dataset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/dataset"}]},
    "records": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/result"}},
    "reason": {"type": ["string", "null"]}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "unavailable"}}, "required": ["status"]}, "then": {"properties": {"dataset": {"type": "null"}, "records": {"maxItems": 0}, "reason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "available"}}, "required": ["status"]}, "then": {"properties": {"dataset": {"$ref": "#/$defs/dataset"}, "reason": {"type": "null"}}}},
    {"if": {"properties": {"mode": {"const": "production"}}, "required": ["mode"]}, "then": {"properties": {"records": {"items": {"allOf": [{"$ref": "#/$defs/result"}, {"properties": {"source_split": {"const": "train"}}}]}}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "slugs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/slug"}},
    "query": {
      "type": "object", "additionalProperties": false,
      "required": ["project_type", "sections", "tags", "manifest_features", "evidence_sha256"],
      "properties": {
        "project_type": {"$ref": "#/$defs/slug"}, "sections": {"$ref": "#/$defs/slugs"},
        "tags": {"$ref": "#/$defs/slugs"}, "manifest_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["dataset_id", "dataset_revision", "manifest_sha256"],
      "properties": {"dataset_id": {"const": "readme-showcase-retrieval"}, "dataset_revision": {"type": "integer", "minimum": 1}, "manifest_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "signals": {
      "type": "object", "additionalProperties": false,
      "required": ["project_type_basis_points", "section_overlap_basis_points", "tag_overlap_basis_points", "manifest_feature_overlap_basis_points", "bm25_basis_points", "diversity_penalty_basis_points"],
      "properties": {
        "project_type_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "section_overlap_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "tag_overlap_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "manifest_feature_overlap_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "bm25_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000},
        "diversity_penalty_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}
      }
    },
    "reason": {
      "type": "object", "additionalProperties": false, "required": ["code", "signal", "matched_values"],
      "properties": {"code": {"type": "string", "minLength": 1}, "signal": {"enum": ["project_type_basis_points", "section_overlap_basis_points", "tag_overlap_basis_points", "manifest_feature_overlap_basis_points", "bm25_basis_points"]}, "matched_values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    },
    "pattern": {
      "type": "object", "additionalProperties": false, "required": ["summary", "structure", "proof"],
      "properties": {"summary": {"type": "string", "minLength": 1}, "structure": {"type": "string", "minLength": 1}, "proof": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_url", "commit", "material_sha256", "license_spdx", "license_evidence_spdx", "license_evidence_url", "license_evidence_sha256", "human_reviewed"],
      "properties": {"repository_url": {"type": "string", "minLength": 1}, "commit": {"type": "string", "minLength": 1}, "material_sha256": {"$ref": "#/$defs/sha256"}, "license_spdx": {"type": "string", "minLength": 1}, "license_evidence_spdx": {"type": "string", "minLength": 1}, "license_evidence_url": {"type": "string", "minLength": 1}, "license_evidence_sha256": {"$ref": "#/$defs/sha256"}, "human_reviewed": {"const": true}}
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["record_id", "score_basis_points", "signals", "reasons", "project_types", "section_intents", "tags", "pattern", "source", "source_split"],
      "properties": {"record_id": {"$ref": "#/$defs/slug"}, "score_basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}, "signals": {"$ref": "#/$defs/signals"}, "reasons": {"type": "array", "items": {"$ref": "#/$defs/reason"}}, "project_types": {"$ref": "#/$defs/slugs"}, "section_intents": {"$ref": "#/$defs/slugs"}, "tags": {"$ref": "#/$defs/slugs"}, "pattern": {"$ref": "#/$defs/pattern"}, "source": {"$ref": "#/$defs/source"}, "source_split": {"enum": ["train", "test"]}}
    }
  }
}
