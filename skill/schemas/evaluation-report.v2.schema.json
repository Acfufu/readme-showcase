{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readme-showcase.local/schemas/evaluation-report.v2.schema.json",
  "title": "Evaluation report v2",
  "$comment": "Structural contract only. Python validation supplements metric equations, canonical ordering, gate/status consistency, and trusted observation binding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "decision_basis", "bundle_sha256", "hard_gate", "advisory", "behavior", "behavior_required"],
  "properties": {
    "schema_version": {"const": 2},
    "status": {"enum": ["pass", "fail"]},
    "decision_basis": {"const": "hard-gates-with-configured-behavior"},
    "bundle_sha256": {"$ref": "#/$defs/sha256"},
    "hard_gate": {"$ref": "#/$defs/hardGate"},
    "advisory": {"$ref": "#/$defs/advisory"},
    "behavior": {"$ref": "#/$defs/behavior"},
    "behavior_required": {"type": "boolean"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1, "maxLength": 4096}, "message": {"type": "string", "minLength": 1, "maxLength": 4096}}},
    "hardGate": {"type": "object", "additionalProperties": false, "required": ["status", "findings"], "properties": {"status": {"enum": ["pass", "fail"]}, "findings": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/finding"}}}},
    "metric": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["covered", "total", "status", "reasons"], "properties": {"covered": {"const": 0}, "total": {"const": 0}, "status": {"const": "not-applicable"}, "reasons": {"type": "array", "maxItems": 0}}},
        {"type": "object", "additionalProperties": false, "required": ["covered", "total", "status", "basis_points", "reasons"], "properties": {"covered": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}, "total": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}, "status": {"const": "measured"}, "basis_points": {"type": "integer", "minimum": 0, "maximum": 10000}, "reasons": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}}
      ]
    },
    "advisory": {"type": "object", "additionalProperties": false, "required": ["claim_coverage", "diagram_label_coverage", "evidence_sources", "language_truth_pairs", "observable_commands", "section_intents", "visual_provenance"], "properties": {"claim_coverage": {"$ref": "#/$defs/metric"}, "diagram_label_coverage": {"$ref": "#/$defs/metric"}, "evidence_sources": {"$ref": "#/$defs/metric"}, "language_truth_pairs": {"$ref": "#/$defs/metric"}, "observable_commands": {"$ref": "#/$defs/metric"}, "section_intents": {"$ref": "#/$defs/metric"}, "visual_provenance": {"$ref": "#/$defs/metric"}}},
    "behaviorCommand": {"type": "object", "additionalProperties": false, "required": ["command_id", "status", "exit_code", "verification", "observation_sha256", "reasons"], "properties": {"command_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"}, "status": {"enum": ["pass", "fail", "unverified", "unsupported", "not-observed"]}, "exit_code": {"type": ["integer", "null"], "minimum": -255, "maximum": 255}, "verification": {"enum": [null, "imported-unverified", "verified"]}, "observation_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "reasons": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}}},
    "behavior": {"type": "object", "additionalProperties": false, "required": ["status", "reasons", "commands", "observable_commands", "total_commands"], "properties": {"status": {"enum": ["pass", "fail", "unverified", "unsupported", "not-observed"]}, "reasons": {"type": "array", "maxItems": 4096, "items": {"type": "string", "minLength": 1, "maxLength": 4096}}, "commands": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/behaviorCommand"}}, "observable_commands": {"type": "integer", "minimum": 0, "maximum": 128}, "total_commands": {"type": "integer", "minimum": 0, "maximum": 128}}, "allOf": [{"if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]}, "then": {"properties": {"commands": {"minItems": 1}, "observable_commands": {"minimum": 1}, "total_commands": {"minimum": 1}}}}]}
  }
}
