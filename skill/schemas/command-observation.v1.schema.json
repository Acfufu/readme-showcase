{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://readme-showcase.local/schemas/command-observation.v1.schema.json",
  "title": "Command observation v1",
  "$comment": "Structural contract only. Python validation supplements canonical input-hash order and binding to expected base SHA, command, cwd, inputs, and out-of-band trusted receipt. Payload verification never establishes trust by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "command", "cwd", "exit_code", "stdout_sha256", "stderr_sha256", "observed_at_base_sha", "input_hashes", "runner", "verification"],
  "properties": {
    "schema_version": {"const": 1},
    "command_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "command": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[^\\u0000]+$"},
    "cwd": {"$ref": "#/$defs/relativePathOrDot"},
    "exit_code": {"type": "integer", "minimum": -255, "maximum": 255},
    "stdout_sha256": {"$ref": "#/$defs/sha256"},
    "stderr_sha256": {"$ref": "#/$defs/sha256"},
    "observed_at_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "input_hashes": {"type": "object", "maxProperties": 128, "propertyNames": {"$ref": "#/$defs/relativePath"}, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "runner": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
    "verification": {"enum": ["imported-unverified", "verified"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relativePath": {"type": "string", "maxLength": 4096, "pattern": "^(?!/)(?!~/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000)[^/]+(?:/[^/]+)*$"},
    "relativePathOrDot": {"anyOf": [{"const": "."}, {"$ref": "#/$defs/relativePath"}]}
  }
}
